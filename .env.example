# Copy to .env.local and fill in. Names only: never commit values.

# Supabase (Project Settings → API). The publishable key is safe in the browser;
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only keys: never prefix these with NEXT_PUBLIC_. In Vercel, add them
# as Secret (Production + Preview).
# USDA FoodData Central, free key from https://api.data.gov/signup
USDA_API_KEY=

# Sentry (optional; error reporting is off when the DSN is empty).
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map upload. Set in Vercel, not locally.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
