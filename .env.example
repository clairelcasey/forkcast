# Copy to .env.local and fill in. Names only: never commit values.

# Supabase (Project Settings → API). The publishable key is safe in the browser;
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only keys: never prefix these with NEXT_PUBLIC_. In Vercel, add them
# as Secret (Production + Preview).
# USDA FoodData Central, free key from https://api.data.gov/signup
USDA_API_KEY=
# Claude API for meal parsing. Set a monthly spend limit in the Console.
# Without this (or USDA_API_KEY) the log box falls back to manual entry.
ANTHROPIC_API_KEY=
# Optional: AI meal parses per user per 24 hours (default 50).
AI_DAILY_PARSE_LIMIT=

# Strava API app (strava.com/settings/api). Callback domain = your app's domain.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Encrypts Strava tokens before they're stored: 32 random bytes, base64
# (openssl rand -base64 32). Changing it means reconnecting Strava.
TOKEN_ENCRYPTION_KEY=
# Testing only: point Strava calls at a local fake server. Leave empty.
STRAVA_BASE_URL=

# Sentry (optional; error reporting is off when the DSN is empty).
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map upload. Set in Vercel, not locally.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
